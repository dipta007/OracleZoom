# NOTE: ref/coz and ref/SDPO are git SUBMODULES (tracked via .gitmodules), NOT ignored.

# --- data + weights (fetch on the GPU box via scripts/setup_data.sh, never commit) ---
# keep the data/ dir (via .gitkeep) but ignore everything downloaded into it
/data/*
!/data/.gitkeep
/models/
/ckpt/
/checkpoints/
*.pth
*.pkl
*.safetensors
*.ckpt
*.bin

# --- run outputs ---
/outputs/
/inference_results/
/runs/
/wandb/
*.log

# --- python / uv ---
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# --- env / secrets ---
.env
*.local.env

# --- macOS ---
.DS_Store

# --- local-only agent instructions (matches at any depth: root or .claude/) ---
CLAUDE.local.md
# the .codex override symlink points at the ignored CLAUDE.local.md -> keep it local too
.codex/agents.override.md

# uv.lock generated by `uv run` on the Mac (tooling-only env; not a locked project env)
uv.lock

# playwright browser screenshot output (local only)
.playwright-mcp/

# local qualitative-review images (large, box-pulled; not for git)
qual_review/imgs/
qual_review/montages_jpg/
qual_review/montages*.tar.gz
qual_review/montages_full_png.tar.gz
qual_review/montages_full/
qual_review/montages_full_png_extracted/
qual_review/human_eval/imgs/
qual_review/human_eval_imgs*.tar.gz
qual_review/human_eval/imgs.tar.gz
qual_review/dashboard_osediff/
qual_review/oz_test_output/
